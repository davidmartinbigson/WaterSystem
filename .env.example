# PostgreSQL connection string (Neon / Vercel Postgres compatible).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Generate distinct random values of 32+ characters; never commit real values.
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters
LICENSE_HASH_SECRET=replace-with-a-different-random-secret-at-least-32-characters

# Provision the initial master administrator. The first login with this email can bootstrap it.
MASTER_ADMIN_EMAIL=admin@your-company.com
MASTER_ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
MASTER_ADMIN_NAME=AquaFlow Platform

# Optional SMTP for one-click customer email reports.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
